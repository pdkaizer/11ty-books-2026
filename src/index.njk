---
layout: layouts/base.njk
---

<div class="book-archive l-wrapper">

  <div class="book-archive__header">
    <h1 class="book-archive__heading" id="archive-heading">All Books</h1>
  </div>

  <div class="tag-filter" role="group" aria-label="Filter by genre">
    <button class="tag-filter__btn is-active" data-tag="all">All</button>
    {% for tag in collections.books | allUniqueTags %}
      <button class="tag-filter__btn" data-tag="{{ tag }}">{{ tag | capitalize }}</button>
    {% endfor %}
  </div>

  <ul class="book-grid" aria-label="Book list" id="book-grid">
    {% for book in collections.books %}
      {% set bookTags = book.data.tags | list | reject("equals", "books") %}
      <li data-tags="{{ bookTags | join(',') }}">
        <a href="{{ book.url }}" class="book-card">
          <div class="book-card__cover">
            {% bookCover book.data.isbn, book.data.title, book.data.coverUrl %}
          </div>
          <div class="book-card__meta">
            <h2 class="book-card__title">{{ book.data.title }}</h2>
            {% if book.data.author %}
              <p class="book-card__author">{{ book.data.author }}</p>
            {% endif %}
          </div>
        </a>
      </li>
    {% endfor %}
  </ul>

</div>

<script>
  (function () {
    var filterBtns = document.querySelectorAll('.tag-filter__btn');
    var bookItems  = document.querySelectorAll('#book-grid li[data-tags]');
    var heading    = document.getElementById('archive-heading');

    filterBtns.forEach(function (btn) {
      btn.addEventListener('click', function () {
        var tag = btn.dataset.tag;

        filterBtns.forEach(function (b) { b.classList.remove('is-active'); });
        btn.classList.add('is-active');

        heading.textContent = tag === 'all' ? 'All Books' : btn.textContent;

        bookItems.forEach(function (item) {
          if (tag === 'all') {
            item.hidden = false;
          } else {
            var tags = item.dataset.tags ? item.dataset.tags.split(',') : [];
            item.hidden = tags.indexOf(tag) === -1;
          }
        });
      });
    });
  })();
</script>
