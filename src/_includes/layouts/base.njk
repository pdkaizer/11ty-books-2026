<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{% if title %}{{ title }} — {% endif %}Peter Kaizer | Recommended Books</title>
  <meta name="description" content="{% if description %}{{ description }}{% elif excerpt %}{{ excerpt }}{% else %}Peter Kaizer's recommended books across fiction, non-fiction, biography, technology, and food.{% endif %}">
  <meta property="og:type" content="website">
  <meta property="og:url" content="{{ site.url }}{{ page.url }}">
  <meta property="og:title" content="{% if title %}{{ title }}{% else %}Peter Kaizer | Recommended Books{% endif %}">
  <meta property="og:description" content="{% if description %}{{ description }}{% elif excerpt %}{{ excerpt }}{% else %}Peter Kaizer's recommended books across fiction, non-fiction, biography, technology, and food.{% endif %}">
  {% if "/books/" in page.url %}
    {% ogImageMeta isbn, coverUrl %}
  {% elif page.url == "/" %}
    {% ogImageMeta currentlyReading.isbn, currentlyReading.coverUrl %}
  {% endif %}
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400..900;1,400..900&family=Source+Sans+3:ital,wght@0,200..900;1,200..900&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/main.css">
  <link rel="icon" type="image/png" href="/images/favicon.png">
  <!-- Privacy-friendly analytics by Plausible -->
  <script async src="https://plausible.io/js/pa-LSwFcFTpYMmMV4LcLPAvW.js"></script>
  <script>
    window.plausible=window.plausible||function(){(plausible.q=plausible.q||[]).push(arguments)},plausible.init=plausible.init||function(i){plausible.o=i||{}};
    plausible.init()
  </script>
  <script>
    try {
      if (localStorage.getItem('theme') === 'dark') {
        document.documentElement.setAttribute('data-theme', 'dark');
      }
    } catch(e) {}
  </script>
</head>
<body>

<div class="l-site">

  <header class="site-header" id="site-header">
    <div class="l-wrapper">
      <a href="/" class="site-logo">
        <img src="/images/PK-logo.svg" alt="" aria-hidden="true" class="site-logo__img">
        Peter Kaizer — Recommended Books
      </a>
      <div class="site-header__controls">
        <button class="nav-toggle" aria-controls="primary-nav" aria-expanded="false" aria-label="Toggle navigation">
          <svg class="nav-toggle__open" width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
            <path d="M2 4h12M2 8h12M2 12h12" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
          </svg>
          <svg class="nav-toggle__close" width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
            <path d="M3 3l10 10M13 3L3 13" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
          </svg>
        </button>
        <ul class="site-nav" id="primary-nav" role="list">
          <li><a href="https://peterkaizer.com">peterkaizer.com</a></li>
        </ul>
        <button class="theme-toggle" aria-label="Toggle dark mode" id="theme-toggle">
          <svg class="theme-toggle__sun" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"/>
          </svg>
          <svg class="theme-toggle__moon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"/>
          </svg>
        </button>
      </div>
    </div>
  </header>

  <main id="content">
    {{ content | safe }}
  </main>

  <footer class="site-footer">
    <div class="l-wrapper">
      <div class="site-footer__info">
        <span>© {{ "" | date("yyyy") if "" else "2025" }} Peter Kaizer</span>
        <span>Recommended reading</span>
      </div>
      <a href="https://peterkaizer.com">peterkaizer.com →</a>
    </div>
  </footer>

</div>

<script>
  // Mobile nav toggle
  var header = document.getElementById('site-header');
  var toggle = header.querySelector('.nav-toggle');
  toggle.addEventListener('click', function() {
    var open = header.hasAttribute('data-menu-open');
    if (open) {
      header.removeAttribute('data-menu-open');
      toggle.setAttribute('aria-expanded', 'false');
    } else {
      header.setAttribute('data-menu-open', '');
      toggle.setAttribute('aria-expanded', 'true');
    }
  });

  // Theme toggle
  var themeToggle = document.getElementById('theme-toggle');
  themeToggle.addEventListener('click', function() {
    var dark = document.documentElement.getAttribute('data-theme') === 'dark';
    var next = dark ? 'light' : 'dark';
    document.documentElement.setAttribute('data-theme', next);
    try { localStorage.setItem('theme', next); } catch(e) {}
  });
</script>

</body>
</html>
